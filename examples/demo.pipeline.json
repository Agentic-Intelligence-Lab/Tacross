{
  "schema_version": 1,
  "name": "demo-synthetic-ego",
  "variables": {
    "demo_root": "{config_dir}/demo_data",
    "ego_root": "{demo_root}/ego",
    "robot_root": "{demo_root}/robot",
    "artifact_root": "{demo_root}/artifacts",
    "project_root": "{config_dir}/..",
    "manifest_raw": "{artifact_root}/manifest_raw.json",
    "manifest_ready": "{artifact_root}/manifest_timeline_ready.json",
    "manifest_ik_ready": "{artifact_root}/manifest_ik_ready.json",
    "derived_root": "{artifact_root}/derived",
    "gripper_prior": "{derived_root}/robot_gripper_prior.json",
    "timeline_adapter": "{project_root}/adapters/build_ego_no_rokoko_15hz_timeline.py",
    "gripper_fusion_adapter": "{project_root}/adapters/fuse_hamer_revo2_gripper.py",
    "simulate_hand_pose": "{project_root}/examples/simulate_hand_pose.py",
    "python": "python",
    "episode_first": "1",
    "episode_last": "3"
  },
  "run_root": "{artifact_root}/runs",
  "stages": [
    {
      "name": "manifest_raw",
      "description": "Check that every demo episode has the required raw channels.",
      "cwd": "{project_root}",
      "requires": ["{ego_root}"],
      "produces": ["{manifest_raw}"],
      "command": [
        "{python}", "postprocess_pipeline/tools/build_episode_manifest.py", "{ego_root}",
        "--output", "{manifest_raw}",
        "--first-episode", "{episode_first}", "--last-episode", "{episode_last}",
        "--required", "rgb/camera1_timestamps.csv",
        "--required", "rgb/camera3_timestamps.csv",
        "--required", "tactile/tactile_timestamps.csv",
        "--required", "sync/trigger_log.json"
      ]
    },
    {
      "name": "sync_15hz",
      "description": "Build the causal 15 Hz camera/tactile timeline (two views, no GoPro).",
      "cwd": "{project_root}",
      "requires": ["{manifest_raw}", "{timeline_adapter}"],
      "produces": ["{ego_root}/episode_000001/sync/unified_no_rokoko_15hz_timeline.csv"],
      "command": [
        "{python}", "postprocess_pipeline/tools/run_with_manifest.py",
        "--manifest", "{manifest_raw}", "--target-flag=--episode", "--",
        "{python}", "{timeline_adapter}", "{ego_root}",
        "--no-camera2", "--skip-failed",
        "--summary-path", "{artifact_root}/timeline_summary.json"
      ]
    },
    {
      "name": "manifest_timeline_ready",
      "description": "Freeze the episode selection after the timeline exists.",
      "cwd": "{project_root}",
      "requires": ["{manifest_raw}"],
      "produces": ["{manifest_ready}"],
      "command": [
        "{python}", "postprocess_pipeline/tools/build_episode_manifest.py", "{ego_root}",
        "--output", "{manifest_ready}",
        "--first-episode", "{episode_first}", "--last-episode", "{episode_last}",
        "--required", "sync/unified_no_rokoko_15hz_timeline.csv"
      ]
    },
    {
      "name": "robot_gripper_prior",
      "description": "Derive open/closed gripper anchors from the robot demonstrations.",
      "cwd": "{project_root}",
      "requires": ["{robot_root}"],
      "produces": ["{gripper_prior}"],
      "command": [
        "{python}", "postprocess_pipeline/tools/build_robot_gripper_prior.py", "{robot_root}",
        "--output-dir", "{derived_root}", "--output-prefix", "robot_gripper_prior",
        "--first-episode", "0", "--last-episode", "3",
        "--state-index", "-1", "--task-scope", "demo grasp-and-place"
      ]
    },
    {
      "name": "simulate_hand_pose",
      "description": "Stand in for the HaMeR + stereo stages on the synthetic recording.",
      "cwd": "{project_root}",
      "requires": ["{manifest_ready}", "{simulate_hand_pose}"],
      "produces": ["{ego_root}/episode_000001/sync/humanego_min/hamer_hand_features_15hz.csv"],
      "command": [
        "{python}", "{simulate_hand_pose}", "--ego-root", "{ego_root}"
      ]
    },
    {
      "name": "fuse_gripper",
      "description": "Fuse visual closure with robot-scale anchors; episode 3 should fail here.",
      "cwd": "{project_root}",
      "requires": ["{manifest_ready}", "{gripper_prior}", "{gripper_fusion_adapter}"],
      "accept_returncodes": [0, 3],
      "command": [
        "{python}", "postprocess_pipeline/tools/run_with_manifest.py",
        "--manifest", "{manifest_ready}", "--mode", "csv", "--target-flag=--episodes", "--",
        "{python}", "{gripper_fusion_adapter}",
        "--source-root", "{ego_root}", "--prior", "{gripper_prior}", "--overwrite"
      ]
    },
    {
      "name": "manifest_ik_ready",
      "description": "Drop episodes missing stereo output or a passing gripper fusion.",
      "cwd": "{project_root}",
      "requires": ["{manifest_ready}"],
      "produces": ["{manifest_ik_ready}"],
      "accept_returncodes": [0, 3],
      "command": [
        "{python}", "postprocess_pipeline/tools/filter_episode_manifest.py",
        "--input", "{manifest_ready}", "--source-root", "{ego_root}",
        "--output", "{manifest_ik_ready}",
        "--required", "sync/humanego_min/T_hand_cam_stereo_open_pipeline_15hz.csv",
        "--required", "sync/gripper_1dof_15hz.csv",
        "--json-equals", "sync/gripper_hamer_robot_prior_metadata.json:status=PASS"
      ]
    }
  ]
}
